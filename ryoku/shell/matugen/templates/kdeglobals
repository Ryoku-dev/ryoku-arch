# Effect blocks are not derived from the palette; these are the stock KDE
# values copied from /usr/share/color-schemes/BreezeClassic.colors.
# Not palette-derived. Stock KDE values from BreezeClassic, so disabled and
# inactive widgets dim the way KDE apps expect.
[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0
