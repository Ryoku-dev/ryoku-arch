#!/usr/bin/env bash
#
# ryoku-greeter: the SDDM Wayland greeter compositor.
#
# Runs `weston --shell=kiosk` at each connected output's top mode (native
# resolution, highest refresh) so the login screen matches a high-refresh
# session instead of the EDID-preferred rate (often 60Hz). This is the Wayland
# equivalent of the xrandr-in-Xsetup hack, without touching a stock SDDM file or
# fighting Hyprland's own mode selection.
#
# modetest (libdrm) reads each connector's modes without holding DRM master, so
# it runs before weston takes the card. Any uncertainty -- no modetest, nothing
# connected, an empty parse -- falls back to plain weston (preferred mode), so
# the greeter always comes up. weston itself ignores an unmatched output mode
# and keeps the preferred one, so a wrong pick degrades to today's behaviour
# rather than a blank login screen.
#
# Which monitor the login form lands on: with two displays weston's kiosk shell
# drops the greeter on whichever output came up first (a DP that trains a beat
# before an HDMI), which is often the wrong one. kiosk-shell can pin a client to
# a named output by its Wayland app-id, so the greeter (sddm-greeter-qt6) is
# pinned to a chosen output: an internal laptop panel when there is one, or the
# connector named in /etc/ryoku/greeter.conf (PRIMARY=<name>, APPID=<id>) or
# RYOKU_GREETER_PRIMARY / RYOKU_GREETER_APPID. Idle blanking is off so a display
# never powers down at the login screen.
set -u

# weston draws the pointer itself (DRM backend) from the XCursor theme named in
# its environment, and SDDM starts the compositor with none: pin the shipped
# Bibata set (ryoku-cursors) so the login screen has a visible pointer whatever
# the "default" theme chain resolves to. Matches GreeterEnvironment in
# /etc/sddm.conf.d/10-ryoku-wayland.conf for the greeter client.
export XCURSOR_THEME="${XCURSOR_THEME:-Bibata-Modern-Ice}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

# weston reads no X11 keyboard config, so without this the greeter is on the
# us map and an AZERTY password fails. The layout localectl recorded goes in
# through the libxkbcommon defaults.
kb_conf=/etc/X11/xorg.conf.d/00-keyboard.conf
if [ -r "$kb_conf" ]; then
  xkb_opt() { sed -n "s/.*Option[[:space:]]*\"$1\"[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$kb_conf" | head -n1; }
  layout=$(xkb_opt XkbLayout); layout=${layout%%,*}
  if [ -n "$layout" ]; then
    export XKB_DEFAULT_LAYOUT="$layout"
    variant=$(xkb_opt XkbVariant); variant=${variant%%,*}
    [ -n "$variant" ] && export XKB_DEFAULT_VARIANT="$variant"
    options=$(xkb_opt XkbOptions)
    [ -n "$options" ] && export XKB_DEFAULT_OPTIONS="$options"
  fi
fi

# Operator config for where the login form lands. env wins over the file; the
# file is /etc/ryoku/greeter.conf with plain KEY=value lines (PRIMARY, APPID).
# greeter_appid is the Wayland app-id kiosk-shell matches: the Qt6 greeter sets
# none, so Qt uses the binary name, sddm-greeter-qt6.
greeter_conf="${RYOKU_GREETER_CONF:-/etc/ryoku/greeter.conf}"
conf_val() { [ -r "$greeter_conf" ] && sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$greeter_conf" | tail -n1; }
greeter_primary="${RYOKU_GREETER_PRIMARY:-$(conf_val PRIMARY)}"
greeter_appid="${RYOKU_GREETER_APPID:-$(conf_val APPID)}"
greeter_appid="${greeter_appid:-sddm-greeter-qt6}"

# Resolve which connector the login form is pinned to. An explicit PRIMARY wins
# when it is actually connected; otherwise an internal laptop panel (eDP/LVDS/DSI)
# is the sensible default. With neither, print nothing: weston keeps its own
# choice and only the mode tuning applies, exactly as before.
choose_primary() {
  local want="$1" names
  names="$(printf '%s\n' "$modes" | awk 'NF { print $1 }')"
  if [ -n "$want" ] && printf '%s\n' "$names" | grep -qxF "$want"; then
    printf '%s' "$want"; return
  fi
  printf '%s\n' "$names" | grep -m1 -E '^(eDP|LVDS|DSI)' || true
}

# exec plain weston (preferred mode); the login screen must always start.
weston_plain() { exec weston --shell=kiosk "$@"; }

command -v weston >/dev/null 2>&1 || { echo "ryoku-greeter: weston not found" >&2; exit 127; }
command -v modetest >/dev/null 2>&1 || weston_plain "$@"

# Per connected connector, pick the largest resolution then its highest refresh.
# Output: "<name> <w> <h> <refresh-string>" lines. Refresh is kept verbatim from
# modetest so weston matches the exact modelist entry. modetest holds no DRM
# master, so this is safe to poll before weston takes the card.
probe_modes() {
  modetest -c 2>/dev/null | awk '
    /^Connectors:/ { insec = 1; next }
    /^(CRTCs|Encoders|Planes|Framebuffers):/ { insec = 0 }
    !insec { next }
    $3 == "connected"    { conn = $4; next }
    $3 == "disconnected" { conn = "";  next }
    conn != "" && $1 ~ /^#[0-9]+$/ {
      split($2, wh, "x"); w = wh[1] + 0; h = wh[2] + 0; rr = $3 + 0
      if (w <= 0 || h <= 0 || rr <= 0) next
      area = w * h
      if (area > ba[conn] || (area == ba[conn] && rr > br[conn])) {
        ba[conn] = area; br[conn] = rr; bw[conn] = w; bh[conn] = h; brs[conn] = $3
      }
    }
    END { for (c in bw) printf "%s %d %d %s\n", c, bw[c], bh[c], brs[c] }
  '
}

gen_ini() {
  # idle-time=0: the login screen must never blank a display out from under the
  # user. One [output] per connected panel at its top mode; the chosen primary
  # also carries app-ids so kiosk-shell drops the greeter window there.
  printf '[core]\nidle-time=0\n\n'
  while read -r name w h rr; do
    [ -n "$name" ] && [ "${w:-0}" -gt 0 ] && [ "${h:-0}" -gt 0 ] || continue
    printf '[output]\nname=%s\nmode=%sx%s@%s\n' "$name" "$w" "$h" "$rr"
    [ -n "$greeter_primary" ] && [ "$name" = "$greeter_primary" ] &&
      printf 'app-ids=%s\n' "$greeter_appid"
    printf '\n'
  done <<< "$modes"
}

# Inspect the generated config without starting the greeter.
if [ "${RYOKU_GREETER_DRYRUN:-0}" = 1 ]; then
  modes="$(probe_modes)"
  greeter_primary="$(choose_primary "$greeter_primary")"
  gen_ini
  exit 0
fi

# Some boards bring one connector up a beat before another (DP a moment before
# HDMI), so a greeter that probes once lights only the fast panel and the login
# lands on the wrong screen -- or on just one of two. Poll until the connected
# set holds steady, giving a slower panel time to arrive, then build the .ini
# from the full set so weston lights every output. Bounded so the login screen
# always starts; tune the floor and cap with RYOKU_GREETER_SETTLE and
# RYOKU_GREETER_DEADLINE (seconds).
settle="${RYOKU_GREETER_SETTLE:-1}"
deadline="${RYOKU_GREETER_DEADLINE:-6}"
start=$SECONDS
modes=""
last=-1
while :; do
  modes="$(probe_modes)"
  n=$(printf '%s' "$modes" | awk 'NF { c++ } END { print c + 0 }')
  elapsed=$(( SECONDS - start ))
  [ "$elapsed" -ge "$deadline" ] && break
  [ "$n" -gt 0 ] && [ "$n" -eq "$last" ] && [ "$elapsed" -ge "$settle" ] && break
  last="$n"
  sleep 0.3
done

[ -n "$modes" ] || weston_plain "$@"

# Pin the login form to the resolved output now that the full connected set is in.
greeter_primary="$(choose_primary "$greeter_primary")"

ini="$(mktemp --tmpdir ryoku-greeter.XXXXXX.ini 2>/dev/null)" || weston_plain "$@"
gen_ini > "$ini"
[ -s "$ini" ] || weston_plain "$@"

exec weston --shell=kiosk --config="$ini" "$@"
